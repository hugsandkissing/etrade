# Copy this file to .env and fill in your values. Never commit .env.
# Get keys at https://developer.etrade.com (sandbox keys are issued instantly;
# production keys require completing E*TRADE's API agreement).
ETRADE_CONSUMER_KEY=your_consumer_key_here
ETRADE_CONSUMER_SECRET=your_consumer_secret_here

# true = sandbox (fake data, safe to experiment), false = live account
ETRADE_SANDBOX=true

# Swagger Engine is shadow-only. These market-data credentials are read at
# runtime and must remain in the untracked .env file or a secret manager.
SWAGGER_MODE=shadow
SWAGGER_BROKER_MODE=mock
SWAGGER_SYMBOLS=VG,SPY,QQQ,XLE
ALPACA_API_KEY=your_alpaca_market_data_key_here
ALPACA_API_SECRET=your_alpaca_market_data_secret_here

# Hard shadow-risk limits. Live mode and real broker execution do not exist.
MAX_CAPITAL=50
SHADOW_STARTING_CASH=50
ACCOUNT_FLOOR=40
ACCOUNT_GOAL=65
MAX_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=5
MARKET_DATA_STALE_SECONDS=15
MAX_SPREAD_PCT=0.75
MIN_FIVE_MINUTE_VOLUME=1000
PROPOSAL_COOLDOWN_SECONDS=300
SHADOW_SLIPPAGE_BPS=5
